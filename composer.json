{
    "name": "tomatophp/filament-helpers",
    "type": "library",
    "description": "Helper Class Generator to manage your forms and table inside your filament app",
    "homepage": "https://tomatophp.com/en/plugins/filament-helpers",
    "support": {
        "issues": "https://github.com/tomatophp/filament-helpers/issues",
        "source": "https://github.com/tomatophp/filament-helpers",
        "docs": "https://tomatophp.com/en/plugins/filament-helpers"
    },
    "keywords": [
        "php",
        "laravel",
        "filament",
        "generator",
        "form class",
        "table class",
        "relation class",
        "field class"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentHelpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentHelpers\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentHelpers\\FilamentHelpersServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0"
}
